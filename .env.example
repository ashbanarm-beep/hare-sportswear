# Server-Side Environment Variables for Hare Sportswear B2B
# In Vercel or production hosting, add these under Project Settings -> Environment Variables.
# NEVER prefix with VITE_ to prevent client-side JavaScript bundling.

GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_SECRET_KEY=HareAdmin2026!SecureCMS

# Email RFQ Delivery (Optional - FormSubmit works automatically as zero-config fallback)
# Option A: Resend API (Recommended)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Hare RFQ Portal <onboarding@resend.dev>

# Option B: Direct SMTP (e.g. Hostinger, cPanel, Google Workspace, Titan)
SMTP_HOST=mail.haresportswear.com
SMTP_PORT=465
SMTP_USER=export@haresportswear.com
SMTP_PASS=your_email_password_here


