{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://*.unsplash.com https://assets.codepen.io; connect-src 'self' https://hare-sportswear.vercel.app https://generativelanguage.googleapis.com https://vitals.vercel-insights.com; frame-ancestors 'self';"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/custom-manufacturing",
      "destination": "/custom-sportswear-manufacturer",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/tools/cost-estimator",
      "destination": "/tools/manufacturing-cost-calculator",
      "permanent": true
    },
    {
      "source": "/cost-estimator",
      "destination": "/tools/manufacturing-cost-calculator",
      "permanent": true
    },
    {
      "source": "/products/womens",
      "destination": "/products/womens-activewear",
      "permanent": true
    },
    {
      "source": "/products/mens-activewear",
      "destination": "/products/activewear",
      "permanent": true
    },
    {
      "source": "/products/caps",
      "destination": "/products/sports-caps",
      "permanent": true
    },
    {
      "source": "/products/headwear",
      "destination": "/products/sports-caps",
      "permanent": true
    },
    {
      "source": "/products/accessories",
      "destination": "/products/equipment",
      "permanent": true
    },
    {
      "source": "/products",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "(?<cat>[^/&]+)"
        },
        {
          "type": "query",
          "key": "sub",
          "value": "(?<subcat>[^/&]+)"
        }
      ],
      "destination": "/products/:cat/:subcat",
      "permanent": true
    },
    {
      "source": "/products",
      "has": [
        {
          "type": "query",
          "key": "category",
          "value": "(?<cat>[^/&]+)"
        }
      ],
      "destination": "/products/:cat",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
